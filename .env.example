# YouTube Data API v3 key — https://console.cloud.google.com
YOUTUBE_API_KEY=your_api_key_here

# Main channel ID — @AfnanTheHorrorWorldBD
YOUTUBE_CHANNEL_ID=your_main_channel_id_here

# Second channel ID — @AfnansBee
AFNANS_BEE_CHANNEL_ID=your_afnans_bee_channel_id_here

# Secret used to authenticate the /api/revalidate webhook
REVALIDATE_SECRET=any_random_string

# Public site URL (no trailing slash) — used for Open Graph & share links
NEXT_PUBLIC_SITE_URL=https://your-domain.com
